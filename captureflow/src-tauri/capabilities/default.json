{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    "opener:default",
    "clipboard-manager:allow-write-image",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
